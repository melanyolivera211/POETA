# ==============================================================================
# POETA: Agente Persistente de Creación Literaria Autónoma
# Archivo de Ejemplo de Variables de Entorno (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. ENTORNO DE EJECUCIÓN Y SEGURIDAD
# ------------------------------------------------------------------------------
APP_ENV=development
PORT=5000
FLASK_DEBUG=false

SECRET_KEY=cambia-esta-clave-secreta-en-produccion
ADMIN_API_TOKEN=cambia-este-token-administrativo-seguro
CORS_ALLOWED_ORIGINS=*

# ------------------------------------------------------------------------------
# 2. BASE DE DATOS SUPABASE (PostgreSQL)
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:TU_PASSWORD@db.tu-proyecto.supabase.co:5432/postgres
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_ANON_KEY=tu_supabase_anon_key_publica
SUPABASE_SERVICE_ROLE_KEY=tu_supabase_service_role_key_privada

# ------------------------------------------------------------------------------
# 3. PROVEEDOR DE INTELIGENCIA ARTIFICIAL (GOOGLE GEMINI API)
# ------------------------------------------------------------------------------
AI_PROVIDER=gemini
GEMINI_API_KEY=tu_gemini_api_key
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_TIMEOUT_SECONDS=60
GEMINI_MAX_RETRIES=2

# ------------------------------------------------------------------------------
# 4. ZONA HORARIA Y PLANIFICADOR
# ------------------------------------------------------------------------------
DISPLAY_TIMEZONE=America/Bogota
WORKER_POLL_SECONDS=15

# ------------------------------------------------------------------------------
# 5. MODO DE PRUEBAS ACELERADO (EXCLUSIVO PARA APP_ENV=testing)
# ------------------------------------------------------------------------------
POETA_ACCELERATED_TEST=false
TEST_CYCLE_DURATION_SECONDS=60
TEST_INTERVENTION_INTERVAL_SECONDS=10
