# ==============================================================================
# POETA: Agente Persistente de Creación Literaria Autónoma
# Archivo de Ejemplo de Variables de Entorno (.env.example)
# ==============================================================================
# INSTRUCCIONES:
# 1. Copia este archivo como `.env` para desarrollo local.
# 2. Nunca subas el archivo `.env` con credenciales reales a GitHub.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. ENTORNO DE EJECUCIÓN Y SEGURIDAD
# ------------------------------------------------------------------------------
# Valores admitidos: development | production | testing
APP_ENV=development
PORT=5000
FLASK_DEBUG=false

# Clave secreta de Flask y token administrativo para operaciones protegidas
# (Ej: POST /api/agent/start). Si se define ADMIN_API_TOKEN, el endpoint
# exigirá la cabecera `X-Admin-Token` o `Authorization: Bearer <token>`.
SECRET_KEY=cambia-esta-clave-secreta-en-produccion
ADMIN_API_TOKEN=cambia-este-token-administrativo-seguro

# Orígenes permitidos para CORS (separados por coma, o * en desarrollo local)
CORS_ALLOWED_ORIGINS=*

# ------------------------------------------------------------------------------
# 2. BASE DE DATOS SUPABASE (PostgreSQL)
# ------------------------------------------------------------------------------
# Cadena de conexión PostgreSQL de Supabase (Transaction/Session Pooler o Direct Connection).
# Formato: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://postgres:TU_PASSWORD@db.tu-proyecto.supabase.co:5432/postgres

# Credenciales del proyecto Supabase (SUPABASE_SERVICE_ROLE_KEY es ESTRICTAMENTE PRIVADA,
# solo debe existir en el backend/worker, jamás en el navegador).
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_ANON_KEY=tu_supabase_anon_key_publica
SUPABASE_SERVICE_ROLE_KEY=tu_supabase_service_role_key_privada

# ------------------------------------------------------------------------------
# 3. PROVEEDOR DE INTELIGENCIA ARTIFICIAL (OLLAMA CLOUD)
# ------------------------------------------------------------------------------
# Endpoint oficial de Ollama Cloud (https://ollama.com/api).
# No confundir con una instancia local (http://localhost:11434).
OLLAMA_BASE_URL=https://ollama.com/api
OLLAMA_API_KEY=tu_ollama_cloud_api_key
OLLAMA_MODEL=gemma3:27b
OLLAMA_TIMEOUT_SECONDS=60
OLLAMA_MAX_RETRIES=2

# ------------------------------------------------------------------------------
# 4. ZONA HORARIA Y PLANIFICADOR
# ------------------------------------------------------------------------------
# Las fechas se almacenan en UTC (TIMESTAMPTZ) y se presentan en America/Bogota
DISPLAY_TIMEZONE=America/Bogota
WORKER_POLL_SECONDS=15

# ------------------------------------------------------------------------------
# 5. MODO DE PRUEBAS ACELERADO (EXCLUSIVO PARA APP_ENV=testing)
# ------------------------------------------------------------------------------
# Estas variables son ignoradas por completo cuando APP_ENV != testing.
POETA_ACCELERATED_TEST=false
TEST_CYCLE_DURATION_SECONDS=60
TEST_INTERVENTION_INTERVAL_SECONDS=10
